                 <VBox.margin>
                     <Insets top="10.0"/>
                 </VBox.margin>
                 <content>
                     <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
                         <children>
                             <HBox maxWidth="1.7976931348623157E308" spacing="25.0" VBox.vgrow="SOMETIMES">
                                 <children>
                                     <VBox fx:id="mimoCell" alignment="CENTER" maxHeight="150.0"
                                           maxWidth="1.7976931348623157E308" minHeight="150.0" minWidth="150.0"
                                           prefHeight="150.0" prefWidth="150.0" styleClass="utility-cell"
                                           HBox.hgrow="ALWAYS">
                                       <children>
                                           <ImageView fitHeight="75.0" fitWidth="75.0" pickOnBounds="true"
                                                      preserveRatio="true">
                                               <image>
                                                   <Image url="@icons/money_in_money_out_96.png"/>
                                               </image>
                                           </ImageView>
                                           <Label alignment="CENTER" maxWidth="1.7976931348623157E308"
                                                  minHeight="-Infinity" minWidth="-Infinity" text="Money In Money Out">
                                               <padding>
                                                   <Insets top="5.0"/>
                                               </padding>
                                               <font>
                                                   <Font name="System Bold" size="16.0"/>
                                               </font>
                                               <styleClass>
                                                   <String fx:value="large-label"/>
                                                   <String fx:value="bold"/>
                                               </styleClass>
                                           </Label>
                                       </children>
                                   </VBox>
                                     <VBox fx:id="breakdownCell" alignment="CENTER" maxHeight="150.0"
                                           maxWidth="1.7976931348623157E308" minHeight="150.0" minWidth="150.0"
                                           prefHeight="150.0" prefWidth="150.0" styleClass="utility-cell"
                                           HBox.hgrow="ALWAYS">
                                       <children>
                                           <ImageView fitHeight="75.0" fitWidth="75.0" pickOnBounds="true"
                                                      preserveRatio="true">
                                               <image>
                                                   <Image url="@icons/fiscal_breakdown_96.png"/>
                                               </image>
                                           </ImageView>
                                           <Label alignment="CENTER" maxWidth="1.7976931348623157E308"
                                                  minHeight="-Infinity" minWidth="-Infinity" text="Fiscal Breakdown">
                                               <padding>
                                                   <Insets top="5.0"/>
                                               </padding>
                                               <font>
                                                   <Font name="System Bold" size="16.0"/>
                                               </font>
                                               <styleClass>
                                                   <String fx:value="large-label"/>
                                                   <String fx:value="bold"/>
                                               </styleClass>
                                           </Label>
                                       </children>
                                   </VBox>
                                     <VBox fx:id="subscriptionsCell" alignment="CENTER" disable="true" maxHeight="150.0"
                                           maxWidth="1.7976931348623157E308" minHeight="150.0" minWidth="150.0"
                                           prefHeight="150.0" prefWidth="150.0" styleClass="utility-cell"
                                           HBox.hgrow="ALWAYS">
                                       <children>
                                           <ImageView fitHeight="75.0" fitWidth="75.0" pickOnBounds="true"
                                                      preserveRatio="true">
                                               <image>
                                                   <Image url="@icons/subscriptions_96.png"/>
                                               </image>
                                           </ImageView>
                                           <Label alignment="CENTER" maxWidth="1.7976931348623157E308"
                                                  minHeight="-Infinity" minWidth="-Infinity" text="Subscriptions">
                                               <padding>
                                                   <Insets top="5.0"/>
                                               </padding>
                                               <font>
                                                   <Font name="System Bold" size="16.0"/>
                                               </font>
                                               <styleClass>
                                                   <String fx:value="large-label"/>
                                                   <String fx:value="bold"/>
                                               </styleClass>
                                           </Label>
                                       </children>
                                   </VBox>
                                 </children>
                             </HBox>
                             <HBox maxWidth="1.7976931348623157E308" spacing="25.0" VBox.vgrow="SOMETIMES">
                                 <children>
                                     <VBox fx:id="pricerCell" alignment="CENTER" maxHeight="150.0"
                                           maxWidth="1.7976931348623157E308" minHeight="150.0" minWidth="150.0"
                                           prefHeight="150.0" prefWidth="150.0" styleClass="utility-cell"
                                           HBox.hgrow="ALWAYS">
                                       <children>
                                           <ImageView fitHeight="75.0" fitWidth="75.0" pickOnBounds="true"
                                                      preserveRatio="true">
                                               <image>
                                                   <Image url="@icons/pricer_96.png"/>
                                               </image>
                                           </ImageView>
                                           <Label alignment="CENTER" maxWidth="1.7976931348623157E308"
                                                  minHeight="-Infinity" minWidth="-Infinity" text="Pricer">
                                               <padding>
                                                   <Insets top="5.0"/>
                                               </padding>
                                               <font>
                                                   <Font name="System Bold" size="16.0"/>
                                               </font>
                                               <styleClass>
                                                   <String fx:value="large-label"/>
                                                   <String fx:value="bold"/>
                                               </styleClass>
                                           </Label>
                                       </children>
                                   </VBox>
                                     <VBox fx:id="settingsCell" alignment="CENTER" maxHeight="150.0"
                                           maxWidth="1.7976931348623157E308" minHeight="150.0" minWidth="150.0"
                                           prefHeight="150.0" prefWidth="150.0" styleClass="utility-cell"
                                           HBox.hgrow="ALWAYS">
                                       <children>
                                           <ImageView fitHeight="75.0" fitWidth="75.0" pickOnBounds="true"
                                                      preserveRatio="true">
                                               <image>
                                                   <Image url="@icons/settings_96.png"/>
                                               </image>
                                           </ImageView>
                                           <Label alignment="CENTER" maxWidth="1.7976931348623157E308"
                                                  minHeight="-Infinity" minWidth="-Infinity" text="Settings">
                                               <padding>
                                                   <Insets top="5.0"/>
                                               </padding>
                                               <font>
                                                   <Font name="System Bold" size="16.0"/>
                                               </font>
                                               <styleClass>
                                                   <String fx:value="large-label"/>
                                                   <String fx:value="bold"/>
                                               </styleClass>
                                           </Label>
                                       </children>
                                   </VBox>
                                 </children>
                             </HBox>
                         </children>
                     </VBox>
                 </content>
             </ScrollPane>
         </children>
         <stylesheets>
            <URL value="@stylesheets/core-ui.css" />
            <URL value="@stylesheets/main.css" />
         </stylesheets>
         <VBox.margin>
            <Insets />
         </VBox.margin>
      </VBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
